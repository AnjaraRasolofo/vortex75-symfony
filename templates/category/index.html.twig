{% extends 'base.html.twig' %}

{% block title %}Vortex75 | {{ title }} {% endblock %}

{% block body %}
{% include '_header.html.twig' %}

    <div class="container my-5">
        {% if not category %}
            <h2 class="mb-4">Dernières actualités</h2>
            <div class="row">
            <!-- Colonne des articles -->
            <div class="col-md-9">
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                {% for post in categories.posts  %}
                <div class="col">
                    <div class="card h-100">
                    {% if post.image %}
                        <img src="{{ asset('assets/images/' ~ post.image) }}"
                            alt="Image de l'article" class="card-img-top object-fit-cover"
                            style="height: 200px; object-fit: cover">
                    {% endif %}

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">{{ post.title }}</h5>

                        <p class="card-text text-muted">
                        <small>
                            Publié le {{ post.publishedAt|date('d M Y') }}
                            {% if post.category %} 
                                • Catégorie : {{ post.category }}
                            {% else %}
                            |   • 'Non catégorisé' 
                            {% endif %}
                        </small>
                        </p>

                        <a href="{{ path('app_post', { slug: post.slug }) }}" class="btn btn-primary mx-auto mt-auto d-block">Lire l'article</a>
                    </div>
                    </div>
                </div>
                {% endfor %}
            </div>
            </div>

            <!-- Colonne des catégories -->
            <div class="col-md-3">
            <div class="card">
                <div class="card-header">
                Catégories
                </div>
                <ul class="list-group list-group-flush">
                {% for category in categories %}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                    <a href="/categorie/{{ category.slug }}">{{ category.slug }}</a>
                    </li>
                {% endfor %}
                </ul>
            </div>
            </div>
        </div>
        {% else %}
            <h2 class="mb-4">{{ category.name }}</h2>
            <p>{{ category.posts|length}} articles dans la catégorie</p>

            <div class="row">
            <!-- Colonne des articles -->
            <div class="col-md-9">
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            {% for post in category.posts  %}
                <div class="col">
                    <div class="card h-100">
                    {% if post.image %}
                        <img src="{{ asset('assets/images/' ~ post.image) }}"
                            alt="Image de l'article" class="card-img-top object-fit-cover"
                            style="height: 200px; object-fit: cover">
                    {% endif %}

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">{{ post.title }}</h5>

                        <p class="card-text text-muted">
                        <small>
                            Publié le {{ post.publishedAt|date('d M Y') }}
                            {% if post.category %} 
                                • Catégorie : {{ post.category }}
                            {% else %}
                            |   • 'Non catégorisé' 
                            {% endif %}
                        </small>
                        </p>

                        <a href="{{ path('app_post', { slug: post.slug }) }}" class="btn btn-primary mx-auto mt-auto d-block">Lire l'article</a>
                    </div>
                    </div>
                </div>
                {% endfor %}
            </div>
            </div>

            <!-- Colonne des catégories -->
            <div class="col-md-3">
            <div class="card">
                <div class="card-header">
                Catégories
                </div>
                <ul class="list-group list-group-flush">
                {% for category in categories %}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                    <a href="/categorie/{{ category.slug }}">{{ category.slug }}</a>
                    </li>
                {% endfor %}
                </ul>
            </div>
            </div>
        </div>
        {% endif %}
    
    
    
    </div>
{% include '_footer.html.twig' %}
{% endblock %}
