<nav class="navbar-custom navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
        <a class="menu-logo navbar-brand" href="/">Vortex<span>75</span></a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-center ms-5" id="navbarNav">

            {# Route actuelle Symfony #}
            {% set currentRoute = app.request.attributes.get('_route') %}

            <!-- Liens gauche -->
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link {{ currentRoute == 'about' ? 'active' : '' }}" href="/about">A propos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ currentRoute == 'guide' ? 'active' : '' }}" href="/guides">Guides</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ currentRoute == 'experts' ? 'active' : '' }}" href="/experts">Indicateurs et Experts</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ currentRoute == 'ressources' ? 'active' : '' }}" href="/tutoriels">Formations</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ currentRoute == 'actualites' ? 'active' : '' }}" href="/actualites">Actualités</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ currentRoute == 'contact' ? 'active' : '' }}" href="/contact">Contact</a>
                </li>
            </ul>

            <!-- Droite : Auth -->
            <ul class="navbar-nav">

                {% if not app.user %}
                    <li class="nav-item">
                        <a class="nav-link text-white" href="{{ path('app_login') }}">Connexion</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_register') }}">Inscription</a>
                    </li>

                {% else %}
                    <li class="nav-item dropdown">
                        <a class="nav-link user-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <strong><i class="bi bi-person"></i> {{ app.user.firstname }}</strong>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item text-dark" href="{{ path('app_account') }}">Mon compte</a>
                            </li>

                            <li>
                                <a class="dropdown-item text-dark" href="{{ path('app_logout') }}">Déconnexion</a>
                            </li>
                        </ul>
                    </li>
                    <li>
                        <a href="/experts/shopping-cart/" class="d-block mx-3 mt-2">
                            <i class="bi bi-cart"></i>
                            {% if 1 %}
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                1
                                </span>
                            {%  else  %}
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-secondary">
                                0
                                </span>
                            {% endif %}
                        </a>
                    </li>
                {% endif %}

            </ul>
        </div>
    </div>
</nav>

<div class="container mt-4">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{label}}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
</div>
