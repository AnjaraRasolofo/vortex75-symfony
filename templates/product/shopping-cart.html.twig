{% extends 'base.html.twig' %}

{% block title %}Vortex 75 | Panier{% endblock %}

{% block body %}
{% include '_header.html.twig' %}

<div class="container py-5">
    <h2 class="mb-4">Votre Panier</h2>

    {% if shoppingCart is not empty %}

        {% set total = 0 %}

        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Image</th>
                    <th>Produit</th>
                    <th>Prix unitaire</th>
                    <th>Quantité</th>
                    <th>Total</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                {% for id, item in shoppingCart %}

                    {% set price = item.price ?? 0 %}
                    {% set quantity = item.quantity ?? 0 %}
                    {% set totalItem = price * quantity %}
                    {% set total = total + totalItem %}

                    <tr>
                        <td width="100">
                            <img
                                src="{{ asset('assets/images/products/' ~ (item.image ?? 'default.jpg')) }}"
                                class="img-fluid"
                                width="80"
                                alt="{{ item.name ?? 'Produit' }}"
                            >
                        </td>

                        <td>{{ item.name ?? 'Sans nom' }}</td>

                        <td>{{ price|number_format(0, '.', '') }} $</td>

                        <td>{{ quantity }}</td>

                        <td>{{ totalItem|number_format(0, '.', '') }} $</td>

                        <td>
                            <form method="POST"
                                  action="{{ path('cart_delete', { id: id }) }}"
                                  onsubmit="return confirm('Supprimer ce produit ?');">

                                <input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ id) }}">

                                <button class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>

                {% endfor %}

                <tr class="table-info">
                    <td colspan="4" class="text-end fw-bold">Total</td>
                    <td colspan="2" class="fw-bold">
                        {{ total|number_format(0, '.', '') }} $
                    </td>
                </tr>

            </tbody>
        </table>

        <form method="POST"
              action="{{ path('cart_reset') }}"
              class="mt-3"
              onsubmit="return confirm('Vider le panier ?')">

            <input type="hidden" name="_token" value="{{ csrf_token('reset_cart') }}">

            <button class="btn btn-outline-danger">
                Vider le panier
            </button>

            <a href="{{ path('app_catalogue') }}"
               class="btn btn-outline-primary">
                Revenir au catalogue
            </a>
        </form>

    {% else %}

        <div class="alert alert-info">
            Votre panier est vide.
        </div>

    {% endif %}
</div>

{% include '_footer.html.twig' %}
{% endblock %}